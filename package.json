{
  "name": "@nitric/suga-icons",
  "version": "0.0.0",
  "description": "Icons drawn on a 16px pixel grid, so they stay sharp at 16px on 1x screens, with some also drawn for 12px and 20px.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitrictech/suga-icons.git"
  },
  "homepage": "https://github.com/nitrictech/suga-icons#readme",
  "bugs": "https://github.com/nitrictech/suga-icons/issues",
  "keywords": [
    "icons",
    "react",
    "svg",
    "pixel-grid",
    "16px",
    "12px",
    "20px"
  ],
  "packageManager": "bun@1.4.2",
  "sideEffects": false,
  "files": [
    "dist",
    "icons"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./svg/*": "./icons/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "build": "bun run generate && tsdown",
    "check": "biome check .",
    "format": "biome check --write .",
    "type-check": "bun run generate && tsc --noEmit",
    "test": "bun run generate && vitest run",
    "preview": "bun run generate && bun preview/index.html",
    "audit": "bun run generate && bun scripts/audit.ts",
    "sharpness": "bun scripts/sharpness.ts"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svgpath": "^2.6.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
